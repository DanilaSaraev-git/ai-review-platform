{
  "name": "@ai-review/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Веб-интерфейс AI Review v1: предварительное ревью ТЗ на данные",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "api:generate": "orval --config orval.config.ts",
