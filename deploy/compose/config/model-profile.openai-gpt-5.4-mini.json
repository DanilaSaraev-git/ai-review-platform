{
  "schema_version": "model-profile.v1",
  "id": "openai-gpt-5.4-mini",
  "version": "1.0.0",
  "adapter_kind": "openai_compatible",
  "provider": "openai",
  "model": "gpt-5.4-mini",
  "checkpoint": null,
  "chat_url": "https://api.openai.com/v1/chat/completions",
  "secret_ref": "OPENAI_API_KEY",
  "capabilities": ["text_generation", "native_structured_output"],
  "context_window_tokens": 400000,
  "max_input_utf8_bytes": 32768,
  "max_output_tokens": 4096,
  "structured_output": "native_json_schema",
  "supported_parameters": ["max_completion_tokens", "reasoning_effort"],
  "request_options": {"reasoning_effort": "none"},
  "probe": {
    "mode": "models",
    "url": "https://api.openai.com/v1/models",
    "timeout_seconds": 5,
    "success_ttl_seconds": 300
  }
}
